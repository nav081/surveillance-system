# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=surveillance
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Admin API ---
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_at_least_32_characters_random
JWT_EXPIRY_MINUTES=60
# Shared secret used by the Monitoring Engine (X-Service-Key header). Generate with: openssl rand -hex 32
SERVICE_API_KEY=CHANGE_ME_service_key
RETENTION_DAYS=7
SWAGGER_ENABLED=false

# --- Web ---
WEB_PORT=8080
# Origin of the browser-facing web app, used for CORS.
PUBLIC_WEB_ORIGIN=http://localhost:8080

# --- Monitoring Engine ---
# Paths inside the container. Mounted from ./models on the host.
# Face weights are typically non-commercial (WIDERFace). Review the license first.
YOLO_WEIGHTS=/models/yolo11n-face.pt
YOLO_FACE_CLASS_ID=0
PERSON_WEIGHTS=/models/yolo11n.pt
PERSON_CONFIDENCE=0.35
PERSON_IMGSZ=960
DETECT_IMGSZ=1280
# cpu or cuda:0 (requires the NVIDIA container runtime)
INFERENCE_DEVICE=cpu
ENGINE_SHARD_COUNT=1
FRAME_STRIDE=3
INSIGHTFACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.45
